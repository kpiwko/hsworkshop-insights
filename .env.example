# Copy to .env and fill in values before running podman compose

# Langfuse public API — port-forward: oc port-forward svc/langfuse -n hsworkshop 3000:3000 &
# The backend runs in a container, so reach the host via host.containers.internal.
LANGFUSE_HOST=http://host.containers.internal:3000
# Project API key: Langfuse UI -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-

# Model for the AI summary (optional). The service is headless, so forward the pod:
# oc port-forward -n hsworkshop $(oc get pod -n hsworkshop -l serving.kserve.io/inferenceservice=qwen36-service -o name | head -1) 18080:8080 &
MODEL_URL=http://host.containers.internal:18080/v1
MODEL_NAME=qwen36-service

# How often (seconds) the SSE stream pushes updates to the frontend
SSE_INTERVAL_SECONDS=30
