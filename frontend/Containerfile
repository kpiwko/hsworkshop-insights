# Bases are pinned by multi-arch INDEX digest (amd64 + arm64).
# Stage 1: build — use host platform so Node/esbuild run natively (avoids QEMU
# crashes on Apple Silicon). The built dist/ is static and architecture-independent.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/nodejs-20@sha256:74cc7b1d13592b1e425074f434b90e470ab209da85fd1fdb8e6e9e4cabaec51a AS build

# UBI nodejs images run as uid 1001; /opt/app-root/src is their writable workdir
WORKDIR /opt/app-root/src
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: serve with the UBI nginx image (nginx preinstalled; no package
# install, so no RHEL subscription is needed). Runs as uid 1001 / gid 0 and is
# OpenShift arbitrary-UID compatible (group-0 writable paths).
FROM registry.access.redhat.com/ubi9/nginx-124@sha256:d5cec86a9adf972dbfa0d87b134e7c404706cc1920fc2e6a2b146e290276f219 AS serve

USER 0
COPY --from=build /opt/app-root/src/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Minimal main config: listen on 8080, pid in /tmp, logs to stdout/stderr, temp
# dirs under /tmp so any UID in group 0 can run it.
RUN printf '%s\n' \
      'worker_processes auto;' \
      'error_log /dev/stderr notice;' \
      'pid /tmp/nginx.pid;' \
      'events { worker_connections 1024; }' \
      'http {' \
      '  include /etc/nginx/mime.types;' \
      '  default_type application/octet-stream;' \
      '  sendfile on;' \
      '  access_log /dev/stdout;' \
      '  client_body_temp_path /tmp/client_temp;' \
      '  proxy_temp_path /tmp/proxy_temp;' \
      '  fastcgi_temp_path /tmp/fastcgi_temp;' \
      '  uwsgi_temp_path /tmp/uwsgi_temp;' \
      '  scgi_temp_path /tmp/scgi_temp;' \
      '  include /etc/nginx/conf.d/*.conf;' \
      '}' \
      > /etc/nginx/nginx.conf \
    && chmod -R g+rX /usr/share/nginx/html /etc/nginx

USER 1001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
